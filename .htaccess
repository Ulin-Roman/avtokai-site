# ============================================
# .htaccess - Главный конфигурационный файл
# Сайт: http://avtokai.ru
# ============================================

# Включаем механизм перенаправления
RewriteEngine On

# ============================================
# CANONICAL HTTPS: fixed host, raw path and unchanged query
# ============================================
RewriteCond %{HTTP_HOST} !^avtokai\.ru$ [NC]
RewriteRule ^ - [E=AVTOKAI_HTTPS_REDIRECT:1]
RewriteCond %{HTTPS} !=on
RewriteCond %{ENV:HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ - [E=AVTOKAI_HTTPS_REDIRECT:1]
RewriteCond %{ENV:AVTOKAI_HTTPS_REDIRECT} =1
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} "^[^[:space:]]+[[:space:]]+(/[^?[:space:]]*)"
RewriteRule ^ https://avtokai.ru%1 [R=301,L,NE]
RewriteCond %{ENV:AVTOKAI_HTTPS_REDIRECT} =1
RewriteCond %{REQUEST_METHOD} !^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} "^[^[:space:]]+[[:space:]]+(/[^?[:space:]]*)"
RewriteRule ^ https://avtokai.ru%1 [R=308,L,NE]

# ============================================
# УБИРАЕМ .php ИЗ URL (ЧПУ)
# ============================================
# Перенаправляем /index на /
RewriteRule ^index$ / [R=301,L]

# Убираем .php в конце URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# ============================================
# КАРТА САЙТА И ROBOTS.TXT
# ============================================
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# ============================================
# ОБРАБОТКА ОШИБОК - ВСЕ НА ГЛАВНУЮ
# ============================================
ErrorDocument 400 /index.php
ErrorDocument 401 /index.php
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
ErrorDocument 500 /index.php

# Любые несуществующие файлы/папки - на главную
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]

# ============================================
# ЗАЩИТА САЙТА
# ============================================

# Запрещаем просмотр директорий
Options -Indexes

# Защита .htaccess
<Files .htaccess>
    Order Allow,Deny
    Deny from all
</Files>

# Защита файлов конфигурации
<FilesMatch "^(config\.php|database\.php|db\.php|\.env|\.git)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Защита логов
<FilesMatch "\.(log|lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Запрет доступа к .php файлам напрямую (кроме index и admin)
<FilesMatch "\.php$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<FilesMatch "^(index|admin|robots|sitemap)\.php$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# ============================================
# КЭШИРОВАНИЕ
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresDefault "access plus 1 month"
</IfModule>

# ============================================
# СЖАТИЕ GZIP
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml application/rss+xml application/atom_xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================
# ЗАГОЛОВКИ БЕЗОПАСНОСТИ
# ============================================
<IfModule mod_headers.c>
    # Защита от XSS
    Header set X-XSS-Protection "1; mode=block"
    
    # Запрет на встраивание в iframe
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Блокировка MIME-типов
    Header set X-Content-Type-Options "nosniff"
    
    # Реферер
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================
# РУССКАЯ КОДИРОВКА
# ============================================
AddDefaultCharset UTF-8

# ============================================
# ЗАПРЕТ НА ЗАГРУЗКУ PHP ФАЙЛОВ В UPLOADS
# ============================================
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|php7|php8|pl|cgi|asp|aspx|jsp)$ - [F,L]
</IfModule>